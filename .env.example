# Copie para variáveis de ambiente da hospedagem (nunca suba a chave real para o GitHub)
ASAAS_API_KEY=            # chave da API (Sandbox para testes; Produção para cobrar de verdade)
ASAAS_ENV=sandbox         # sandbox | production
ASAAS_WEBHOOK_TOKEN=      # o mesmo "token de autenticação" cadastrado no webhook da Asaas
ASAAS_BILLING_TYPE=UNDEFINED  # UNDEFINED deixa o cliente escolher Pix, boleto ou cartão
